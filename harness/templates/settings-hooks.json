{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/env-check.sh",
            "timeout": 10,
            "statusMessage": "환경 진단 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/sdk-guard.sh",
            "if": "Bash(*${SDK_CMD_NAME} *)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/run-guard.sh",
            "if": "Bash(*${RUN_CMD_PATTERN} *)",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
