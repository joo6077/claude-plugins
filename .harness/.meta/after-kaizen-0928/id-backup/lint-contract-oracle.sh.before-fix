#!/usr/bin/env bash
# Sprint Contract 저장 시, 조건의 «측정 oracle» 이 서술 존재 확인에 그치면 경고한다.
#
# 근거:
#   - memory feedback_oracle_must_execute_not_grep — 2026-07-28 harness 스프린트에서
#     계약 25 조건이 «전부 PASS» 인데 기능이 완전히 깨져 있었다. oracle 이 죄다
#     "문서에 서술 존재" 였기 때문이다. 검증 지시를 "실행 결과만이 증거" 로 바꾸자
#     blocking 7 건이 즉시 드러났다.
#   - docs/superpowers/followup-kaizen-memory-integration.md §훅 승격 후보 —
#     이 항목은 «훅이 아니라 계약 린터» 로 분류되어 있다. 그래서 차단하지 않는다.
#
# «차단하지 않는다» 가 이 훅의 하드 규칙이다. 계약 작성을 막으면 안 된다 —
# PostToolUse 는 애초에 permissionDecision 을 지원하지 않고(v2.1.232 훅 문서),
# 여기서는 additionalContext 로 모델 컨텍스트에 경고만 주입한다.
#
# 검출기이지 게이트가 아니다. contract-schema §측정 커버리지 검출기 와 같은 성격으로,
# 오탐이 존재하는 것을 전제로 «1 건마다 조건 수정 또는 해소 기록» 을 요구할 뿐이다.
#
# fail-open: jq 부재·빈 stdin·깨진 JSON·읽기 실패 어느 경우에도 exit 0. errexit 를 쓰지 않는다.
set -uo pipefail

LIB="${CLAUDE_HOOK_LIB:-$HOME/.claude/hooks/_lib-hook-payload.sh}"
# shellcheck source=/dev/null
. "$LIB" 2>/dev/null || exit 0

payload="$(cat 2>/dev/null || true)"
[ -n "$payload" ] || exit 0

tool="$(hook_field "$payload" '.tool_name')"
case "$tool" in
  Edit|Write|MultiEdit) ;;
  *) exit 0 ;;
esac

f="$(hook_field "$payload" '.tool_input.file_path')"
[ -n "$f" ] || exit 0
[ -f "$f" ] || exit 0

# 대상은 .harness/ 아래의 계약 파일뿐이다 (plain · 접미형 양쪽).
case "$f" in
  */.harness/sprint-contract.md|*/.harness/sprint-contract-*.md) ;;
  *) exit 0 ;;
esac

# ── 검출기 ──
# 조건 블록(조건 줄 + 이어지는 들여쓴 줄)을 모아 «측정» 이후를 oracle 로 본다.
#
# D1 산문-grep — oracle 이 grep 계열이고, 그 대상이 «자연어 문장» 이다.
#   실측 원형: Phase6 AR-03 의 `표준으로 강제하지 않는다` `grep -cF` >= 1.
#   비교 연산자가 붙어 있어도 재는 것은 "문서에 그 문장이 있는가" 뿐이라 oracle 이 아니다.
# D2 실행신호-부재 — oracle 이 grep 계열인데 실행·비교·출력 관찰 신호가 하나도 없다.
#
# 비ASCII 판정은 «출력 가능한 ASCII 를 지우고 남는 게 있는가» 로 한다.
# awk 구현마다 유니코드 문자클래스 지원이 갈리므로 바이트 기준으로 본다.
findings="$(
  awk '
  function is_prose(t,   c) {
    # 실측 실패 모드는 «한글 산문 문장» 을 grep 대상으로 삼는 것이다 (Phase6 AR-03 의
    # `표준으로 강제하지 않는다`). 따라서 판정은 «한글이 남는가» 로 좁힌다.
    #
    # 구조용 비ASCII 기호는 먼저 지운다. 안 지우면 `§5.6` `§5 Variant Contract Matrix`
    # 같은 «절 참조 토큰» 이 비ASCII 라는 이유만으로 산문으로 잡힌다 (실측 오탐 2 건).
    c = t
    gsub(/§/, "", c); gsub(/·/, "", c); gsub(/—/, "", c); gsub(/«/, "", c); gsub(/»/, "", c)
    gsub(/→/, "", c); gsub(/←/, "", c); gsub(/×/, "", c); gsub(/≥/, "", c); gsub(/≤/, "", c)
    gsub(/[ -~]/, "", c)              # 출력 가능한 ASCII 제거 → 남으면 한글 등 자연어
    return (c != "")
  }
  function is_command(t) {
    return (t ~ /^(grep|rg|git|python3?|bash|zsh|sh|awk|sed|find|wc|jq|comm|cut|sort|uniq|head|tail|cat|test|ls|diff|shasum|sha256sum|openssl|printf|echo|npm|npx|node|cargo|make|fvm|flutter|dart|curl|xargs|tr|paste|basename|dirname|stat|date)([ -]|$)/)
  }
  function flush(   pos, m, n, i, parts, t, prose, exec_sig, tag) {
    if (id == "") return
    pos = index(buf, "측정")
    if (pos == 0) { id = ""; buf = ""; return }
    m = substr(buf, pos)
    if (m !~ /grep|[^a-z]rg /) { id = ""; buf = ""; return }

    prose = 0
    n = split(m, parts, "`")
    for (i = 2; i <= n; i += 2) {
      t = parts[i]
      if (t == "") continue
      if (is_command(t)) continue
      if (is_prose(t)) { prose = 1; break }
    }
    exec_sig = (m ~ /실행|돌려|출력|결과|종료 코드|exit|음성 대조|>=|<=|==|[0-9] 건|wc -l|-c |grep -c|diff/)

    tag = ""
    if (prose)          tag = "산문-grep"
    else if (!exec_sig) tag = "실행신호-부재"
    if (tag != "") printf "%s\t%s\n", id, tag
    id = ""; buf = ""
  }
  match($0, /^- \[[ x]\] [A-Z]{2,}-[0-9]{2}/) {
    flush(); id = substr($0, RSTART + 6, RLENGTH - 6); sub(/^[^A-Z]*/, "", id); buf = $0; next
  }
  /^## /  { flush(); next }
  /^- \[/ { flush(); next }
  { if (id != "") buf = buf " " $0 }
  END { flush() }
  ' "$f" 2>/dev/null || true
)"

[ -n "$findings" ] || exit 0

n=$(printf '%s\n' "$findings" | grep -c . 2>/dev/null || printf '0')
list="$(printf '%s\n' "$findings" | awk -F'\t' '{printf "  - %s (%s)\n", $1, $2}')"

hook_notice "[계약 오라클 경고] $(basename "$f") 의 조건 ${n} 건에서 측정 oracle 이 «서술 존재 확인» 에 그친다:
${list}
왜 문제인가: 2026-07-28 harness 스프린트에서 계약 25 조건이 전부 PASS 인데 기능이 완전히 깨져 있었다. oracle 이 죄다 '문서에 서술이 존재하는가' 였기 때문이다 (memory feedback_oracle_must_execute_not_grep). 검증 지시를 '실행 결과만이 증거' 로 바꾸자 blocking 7 건이 즉시 드러났다.
어떻게 고치나: (a) 문서에 셸 스니펫을 넣었으면 «문서에서 원문 그대로 추출해 실행» 하고 그 출력으로 판정하라 — 재타이핑하면 검증 가치가 없다. (b) 산출물이 동작이면 그 동작을 «호출» 해서 관찰하라. (c) 조건에 '음성 대조:' 절을 붙여 어느 구현 지점을 무력화하면 그 측정이 FAIL 하는지 적어라 — 구현을 지워도 통과하는 측정문은 oracle 이 아니다.
이것은 검출기이지 게이트가 아니다 — 차단하지 않았다. 오탐이면 계약 서술 섹션에 '오라클 해소: {조건 ID} — {사유}' 한 줄을 남겨라." "계약 오라클 경고 ${n} 건 — $(basename "$f")"
