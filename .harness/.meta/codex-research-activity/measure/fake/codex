#!/usr/bin/env python3
# 가짜 codex — `codex exec --json ... -c notify=[sink, 신호파일] -o <출력> <프롬프트>` 를 흉내 낸다.
# 사건(thread.started)은 stdout 에 실제처럼 빈칸 없는 JSON 으로, 세션 기록은 $CODEX_SESS_DIR 아래
# rollout-*-<id>.jsonl 에 시간차를 두고 쓴다. 기록 줄 모양은 2026-10 실제 리서치 기록에서 옮겼다:
#   검색 · 열람 = custom_tool_call exec 입력의 tools.web__run({search_query:[{q:…}], open:[{ref_id:…}]})
#   셸 명령    = custom_tool_call exec 입력의 tools.exec_command({cmd:"…", workdir:…})
#   중간 말    = message · phase commentary,  최종 답 = message · phase final_answer
# FAKE_SCENARIO: ok · fail-then-ok · corrupt · partial · burst
import json, os, re, sys, time, uuid
args = sys.argv[1:]
out = args[args.index('-o') + 1]
notify = next((re.findall(r'"([^"]+)"', a)[-1] for a in args if a.startswith('notify=')), None)
scenario = os.environ.get('FAKE_SCENARIO', 'ok')
step = float(os.environ.get('FAKE_STEP', '4'))
counter = os.path.join(os.environ['FAKE_STATE'], 'calls')
calls = int(open(counter).read()) + 1 if os.path.exists(counter) else 1
open(counter, 'w').write(str(calls))
tid = str(uuid.uuid4())
day = os.path.join(os.environ['CODEX_SESS_DIR'], '2026', '10', '09')
os.makedirs(day, exist_ok=True)
roll = os.path.join(day, 'rollout-2026-10-09T00-00-00-' + tid + '.jsonl')
compact = dict(ensure_ascii=False, separators=(',', ':'))
print(json.dumps({'type': 'thread.started', 'thread_id': tid}, **compact), flush=True)


def put(*items):
    with open(roll, 'a', encoding='utf-8') as f:
        for item in items:
            f.write((item if isinstance(item, str) else json.dumps(item, **compact)) + '\n')


def msg(phase, text):
    return {'type': 'response_item', 'payload': {'type': 'message', 'role': 'assistant', 'phase': phase,
                                                 'content': [{'type': 'output_text', 'text': text}]}}


def code(source):
    return {'type': 'response_item', 'payload': {'type': 'custom_tool_call', 'name': 'exec', 'input': source}}


def search(*qs):
    return code('const r = await tools.web__run({search_query:[' + ','.join('{q:"%s"}' % q for q in qs) + ']});')


def finish():
    put(msg('final_answer', '최종답본문 비밀글자 QQZ'))
    open(out, 'w').write('최종답본문 비밀글자 QQZ\n')
    if notify:
        open(notify, 'w').write(json.dumps({'type': 'agent-turn-complete', 'last-assistant-message': '최종답본문 비밀글자 QQZ'}))
    time.sleep(0.5)
    sys.exit(0)


put({'type': 'session_meta', 'payload': {'id': tid}},
    {'type': 'response_item', 'payload': {'type': 'reasoning', 'summary': [], 'encrypted_content': 'xx'}})

if scenario == 'fail-then-ok':
    if calls == 1:
        put(msg('commentary', '첫시도말 확인하겠습니다.'), search('first attempt query'))
        time.sleep(step)
        sys.exit(1)
    put(msg('commentary', '둘째시도말 다른 길로 갑니다.'), search('second attempt query'))
    time.sleep(step)
    finish()

if scenario == 'partial':
    line = json.dumps(search('partial query'), **compact)
    with open(roll, 'a', encoding='utf-8') as f:
        f.write(line[:40])
    time.sleep(step)          # 반쯤 쓰인 줄 위로 진행 주기가 지나간다
    with open(roll, 'a', encoding='utf-8') as f:
        f.write(line[40:] + '\n')
    time.sleep(step)
    finish()

if scenario == 'burst':
    put(search(*['burst q%02d' % n for n in range(1, 13)]))
    time.sleep(step)
    finish()

put(msg('commentary', '공식 문서부터 확인하겠습니다.'), search('alpha query one', 'beta query two'))
if scenario == 'corrupt':
    put('x{',
        '{"type":"response_item","payload":null}',
        '{"type":"response_item","payload":"문자열"}',
        '{"type":"response_item","payload":{"type":"message","phase":"commentary","content":["사전아님"]}}',
        '{"type":"response_item","payload":{"type":"custom_tool_call","name":"exec","input":123}}',
        '{"type":"response_item","payload":{"type":"message","phase":"comm',
        json.dumps(msg('commentary', '깨진뒤말 이어갑니다.'), **compact))
time.sleep(step)
put(code('const r = await tools.web__run({"search_query":[{"q":"gamma quoted"}],'
         '"open":[{"ref_id":"turn0search0"},{"ref_id":"https://example.com/doc","lineno":12}]});'),
    code('const r = await tools.exec_command({cmd:"gh api repos/x/y/releases", workdir:"/tmp"});'),
    code('const cmd = "ls -la"; const r = await tools.exec_command({cmd,workdir:"/tmp"});'),
    msg('commentary', '긴말' + '가' * 250 + '\n' + '나' * 250))
time.sleep(step)
finish()
