// 기본기 검사가 위젯을 띄우는 환경. 앱 위젯이 상태 저장소 · 번역 · 테마를
// 찾으면 여기에 붙인다 — 빠지면 그리기 실패가 「감싸개」 안내와 함께 나온다.
import 'package:flutter/material.dart';

/// 검사가 돌리는 언어.
const hostLocales = [Locale('en')];

/// 언어마다 검사 전에 한 번 부른다. 앱 번역 언어를 여기서 바꾼다.
Future<void> setUpHost(Locale locale) async {}

/// 위젯 하나를 앱과 같은 환경으로 감싼다.
Widget wrap(
  Widget child, {
  required double textScale,
  required Locale locale,
}) {
  return MaterialApp(
    debugShowCheckedModeBanner: false,
    locale: locale,
    theme: ThemeData(),
    home: Builder(
      builder: (context) => MediaQuery(
        data: MediaQuery.of(context).copyWith(
          textScaler: TextScaler.linear(textScale),
        ),
        child: Material(type: MaterialType.transparency, child: child),
      ),
    ),
  );
}
