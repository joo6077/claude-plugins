use async_trait::async_trait;
use crate::domain::errors::DomainError;

#[async_trait]
pub trait {{MODEL_NAME}}Repository: Send + Sync {
    async fn find_by_id(&self, id: {{ID_TYPE}}) -> Result<Option<{{MODEL_NAME}}>, DomainError>;
    async fn find_all(&self) -> Result<Vec<{{MODEL_NAME}}>, DomainError>;
    async fn create(&self, {{CREATE_PARAMS}}) -> Result<{{MODEL_NAME}}, DomainError>;
    async fn update(&self, id: {{ID_TYPE}}, {{UPDATE_PARAMS}}) -> Result<{{MODEL_NAME}}, DomainError>;
    async fn delete(&self, id: {{ID_TYPE}}) -> Result<(), DomainError>;
    {{REPOSITORY_METHODS}}
}

// ── SQLx 어댑터 (infra/adapters/{{TABLE_NAME}}_repository_impl.rs) ──
// 이 파일은 HAS_SQLX 경로에서만 생성된다

use sqlx::PgPool;

pub struct Pg{{MODEL_NAME}}Repository {
    pool: PgPool,
}

impl Pg{{MODEL_NAME}}Repository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl {{MODEL_NAME}}Repository for Pg{{MODEL_NAME}}Repository {
    async fn find_by_id(&self, id: {{ID_TYPE}}) -> Result<Option<{{MODEL_NAME}}>, DomainError> {
        let row = sqlx::query_as!(
            {{MODEL_NAME}},
            r#"SELECT {{SELECT_COLUMNS}} FROM {{TABLE_NAME}} WHERE id = $1"#,
            id
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(DomainError::from)?;
        Ok(row)
    }

    // ... 나머지 CRUD 메서드는 rust-model 스킬이 필드 정보로 생성
}

